# The RISC-V test image: the system of ../default.pyb, built for riscv64
# through config.pyb (RFC 0006 section 9). Build its disk image with
#
#     lattice build --package-set pkgs pkgs/systems/riscv64/default.pyb image
#
# and boot it in QEMU with ARCH=riscv64 scripts/boot-test.sh.

system = pyrixos_system("default", default_file_systems(), services=[serial_autologin])

image = disk_image(system)

# The firmware that starts the disk image without UEFI: OpenSBI and
# U-Boot, for FIRMWARE=u-boot UBOOT=DIR scripts/boot-test.sh.
firmware = uboot_firmware
