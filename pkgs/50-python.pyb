# cryptography's cffi bindings are generated by a build script that runs
# Python with cffi, and its library is built for the stable ABI.
cryptography = python_rust(
    "cryptography",
    "50.0.2",
    pypi("9d/af/182eb91b0df3fe75c4d9f26fe70684569566745f6ba7e5c9c73a862c5252", "cryptography", "50.0.2", "7b46165bb56eb4704e2eaaf86f3c940d19154535d9b0ca7d6d590b04060e00d5"),
    CRYPTOGRAPHY_CRATES,
    [cffi, pycparser, setuptools, openssl, pkgconf],
    "cargo build -p cryptography-rust",
    "libcryptography_rust.so",
    "src/cryptography",
    "cryptography/hazmat/bindings/_rust.abi3.so",
    {"OPENSSL_DIR": openssl, "OPENSSL_NO_VENDOR": "1"},
)

