# SPDX-License-Identifier: GPL-2.0
# Layer 50: Lattice and the Python packages it runs on (RFC 0005
# section 6). Every package here is pure Python: Lattice, Cloche and
# Trellis validate their models with Espalier and sign the cache with
# pyrixos-ed25519, so no Rust or C extension is built.
#
# `python_rust` and `cargo_vendor` build a Rust extension with the Rust
# toolchain of the RUST option, for package sets layered on this one:
# cargo builds it against crates vendored from its Cargo.lock, which
# scripts/cargo-crates.py turns into a list, and the module is copied
# into place as maturin would. `python_modules` copies the modules of a
# package whose build backend is not in the set.

# The crates of a Cargo.lock as a directory source: each .crate archive
# is unpacked into <name>-<version> with the checksum file cargo checks.
UNPACK_CRATE = """unpack_crate() {
  mkdir -p "$out/$2"
  tar xzf "$1" --no-same-owner -C "$out/$2" --strip-components=1
  printf '{"files":{},"package":"%s"}' "$3" > "$out/$2/.cargo-checksum.json"
}
"""


def crate(name, version, sha256):
    return fetch_url(f"https://static.crates.io/crates/{name}/{name}-{version}.crate", sha256)


def cargo_vendor(name, crates):
    sources = [crate(c[0], c[1], c[2]) for c in crates]
    steps = [f'unpack_crate "$crate{i}" {c[0]}-{c[1]} {c[2]}\n' for i, c in enumerate(crates)]
    return build(
        f"{name}-crates",
        "1",
        sources[0],
        phases={
            "unpack": "",
            "patch": "",
            "configure": "",
            "build": UNPACK_CRATE + "".join(steps),
            "install": "",
            "fixup": "",
        },
        env={f"crate{i}": src for i, src in enumerate(sources)},
    )


# Points cargo at the vendored crates in $vendor, offline, and passes
# the run paths of the standard environment to the linker.
CARGO_SETUP = """export CARGO_HOME=/build/cargo-home CARGO_BUILD_JOBS="$J"
mkdir -p "$CARGO_HOME"
printf '[source.crates-io]\nreplace-with = "vendored"\n[source.vendored]\ndirectory = "%s"\n[net]\noffline = true\n' \
  "$vendor" > "$CARGO_HOME/config.toml"
RUSTFLAGS=
for flag in $LDFLAGS; do RUSTFLAGS="$RUSTFLAGS -C link-arg=$flag"; done
export RUSTFLAGS PYO3_PYTHON=python3 PYO3_BUILD_EXTENSION_MODULE=1
"""

# Installs the metadata of the source distribution in the current
# directory, so importlib.metadata finds the package, and compiles the
# modules; SOURCE_DATE_EPOCH makes the bytecode checked by hash.
DIST_INFO = f"""dist_info() {{
  d="$out/{SITE_PACKAGES}/$1-$2.dist-info"
  mkdir -p "$d"
  cp PKG-INFO "$d/METADATA"
  printf 'Wheel-Version: 1.0\\nGenerator: pyrixos\\nRoot-Is-Purelib: true\\nTag: py3-none-any\\n' > "$d/WHEEL"
  echo pyrixos > "$d/INSTALLER"
  : > "$d/RECORD"
  python3 -m compileall -q "$out/{SITE_PACKAGES}"
}}
"""


# A pure Python package whose modules are the directories `modules` of
# the source distribution.
def python_modules(name, version, src, modules, inputs=[]):
    copies = "".join([f'cp -r {m} "$out/{SITE_PACKAGES}/"\n' for m in modules])
    return build(
        f"python-{name}",
        version,
        src,
        [python] + inputs,
        phases={
            "configure": "",
            "build": "",
            "install": f'mkdir -p "$out/{SITE_PACKAGES}"\n' + copies + DIST_INFO + f"dist_info {name.replace('-', '_')} {version}\n",
        },
    )


# A Rust extension built with cargo: `build` is the cargo command and
# `module` the path, under site-packages, of the library it installs as.
def python_rust(name, version, src, crates, inputs, cargo, library, python_source, module, env={}):
    return build(
        f"python-{name}",
        version,
        src,
        [python, rust] + inputs,
        phases={
            "configure": PYTHON_SETUP + CARGO_SETUP,
            "build": cargo + " --release --locked\n",
            "install": f"""mkdir -p "$out/{SITE_PACKAGES}"
cp -r {python_source} "$out/{SITE_PACKAGES}/"
cp target/release/{library} "$out/{SITE_PACKAGES}/{module}"
"""
            + DIST_INFO
            + f"dist_info {name.replace('-', '_')} {version}\n",
        },
        env={key: value for key, value in [("vendor", cargo_vendor(name, crates))] + [(k, v) for k, v in env.items()]},
    )


# The PyrixOS components, from the source distributions on PyPI.
espalier_src = pypi("51/df/50d9508dd220782acf1c8c4714c9e61563574e81778a054295fa149a02df", "pyrixos_espalier", "1.1.0", "aa79d91efdad9eaa10f52659549159cbb9cc19ba42e24388cadbd077534566df")
ed25519_src = pypi("b4/db/1a5bcc1260b155dc7ff3a884b9845b92ae250ee5fefd1d8bb00a541b0460", "pyrixos_ed25519", "1.0.0", "759e4a259087e815a8060bbea4d264a95f510d02a643033701c4aa6fce3c2afc")
trellis_src = pypi("e7/95/5a97c4b4978c56d292e2f342affbd2568d41eeb5f5fccb8337f914b503a9", "trellis_kconfig", "1.1.0", "7e2986ad83944ae4cad13dc6e1e1144cdfb956ad0dce0764f5028af3abd029c7")
cloche_src = pypi("0c/fc/78bff7f77dad800ab621c6f94537edc9f42e02ec5027c390e06e448415dc", "cloche", "1.2.0", "e0e0c647a2d3b33aa6a9786740dc0f35358116e257bc1e0214d13d381880a653")
lattice_src = pypi("77/68/c02b27863568237cd5e9ceae0b9d87a646b4853c1b358acd40534ec59ddf", "pyrixos_lattice", "0.14.0", "e5e360620797a1f04298eaf2c30c3acf4db56b9ea8e323fbcb2b63c1cb5b2e1d")

espalier = python_package("pyrixos-espalier", "1.1.0", espalier_src, [setuptools])
ed25519 = python_package("pyrixos-ed25519", "1.0.0", ed25519_src, [setuptools])
pybonsai = python_package("pybonsai-lang", "1.2.0", pypi("20/d9/c1710a2affbf4cbeb14c6fb173e388a63b5acb2b07bf0e135ab48a7b6126", "pybonsai_lang", "1.2.0", "ac09e2185ff1c922daf9a049481586793dfac2461407698b5d9f0f2d739efce9"), [setuptools])
cloche = python_package("cloche", "1.2.0", cloche_src, [setuptools, espalier])
trellis = python_package("trellis-kconfig", "1.1.0", trellis_src, [setuptools, espalier])
lattice = python_package("pyrixos-lattice", "0.14.0", lattice_src, [setuptools, espalier, ed25519, pybonsai, cloche])

PYTHON_PACKAGES = [espalier, ed25519, pybonsai, cloche, trellis, lattice]
python_packages = stage("python-packages", SHELL_3, PYTHON_PACKAGES, [coreutils_3, sed_3])
